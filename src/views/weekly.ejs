<% if (typeof isListView !== 'undefined' && isListView) { %>
    <div class="space-y-6">
        <h2 class="text-xl font-bold mb-4 text-foreground">周榜历史</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <% dateCards.forEach(card => { %>
                <a href="/<%= type %>/<%= card.dateStr %>.html" class="block p-6 bg-card rounded-lg border border-border hover:border-primary hover:shadow-md transition-all group flex flex-col h-full">
                    <div class="mb-4 flex-grow">
                        <h3 class="text-lg font-semibold text-foreground group-hover:text-primary mb-2 transition-colors">
                            <%= card.dateStr.substring(0, 4) %> 年第 <%= card.dateStr.substring(4) %> 周
                        </h3>
                        <p class="text-sm text-muted-foreground">共 <%= card.total %> 个热门项目</p>
                    </div>
                    
                    <% if (card.langStats && card.langStats.length > 0) { %>
                        <div class="flex flex-wrap gap-1.5 mt-auto border-t border-border pt-4">
                            <% card.langStats.forEach(stat => { %>
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-muted text-muted-foreground">
                                    <%= stat.lang %>: <%= stat.count %>
                                </span>
                            <% }) %>
                        </div>
                    <% } %>
                </a>
            <% }) %>
            <% if (dateCards.length === 0) { %>
                <div class="col-span-full py-12 text-center text-muted-foreground bg-card rounded-lg border border-border border-dashed">
                    暂无历史数据
                </div>
            <% } %>
        </div>
    </div>
<% } else { %>
<div class="space-y-6">
    <!-- Filters Area -->
    <div class="bg-card rounded-lg border border-border p-4 flex flex-col gap-4 shadow-sm">
        
        <!-- Date Selector -->
        <div class="flex items-center gap-4">
            <span class="text-sm font-semibold text-foreground">选择周数:</span>
            <div class="flex gap-2 overflow-x-auto pb-2 custom-scrollbar">
                <% dates.slice(0, 14).forEach(dateStr => { %>
                    <a href="/<%= type %>/<%= dateStr %>.html<%= selectedLang ? '?lang=' + encodeURIComponent(selectedLang) : '' %>" 
                       class="px-3 py-1.5 rounded-md text-sm border whitespace-nowrap transition-colors <%= selectedDate === dateStr ? 'bg-primary text-primary-foreground border-primary' : 'bg-background border-border text-muted-foreground hover:bg-muted' %>">
                        <%= dateStr.substring(0, 4) %> 年第 <%= dateStr.substring(4) %> 周
                    </a>
                <% }) %>
                <% if (dates.length === 0) { %>
                    <span class="text-sm text-muted-foreground">暂无数据</span>
                <% } %>
            </div>
        </div>

        <!-- Language Selector -->
        <% if (languages.length > 0) { %>
        <div class="flex items-center gap-4 border-t border-border pt-4">
            <span class="text-sm font-semibold text-foreground whitespace-nowrap">开发语言:</span>
            <div class="flex gap-2 flex-wrap">
                <a href="?lang=" 
                   class="px-3 py-1 rounded-full text-xs border transition-colors <%= !selectedLang ? 'bg-blue-100 text-blue-700 border-blue-200 dark:bg-blue-900/30 dark:text-blue-400 dark:border-blue-800' : 'bg-background border-border text-muted-foreground hover:bg-muted' %>">
                    全部
                </a>
                <% languages.forEach(lang => { %>
                    <a href="?lang=<%= encodeURIComponent(lang) %>" 
                       class="px-3 py-1 rounded-full text-xs border transition-colors <%= selectedLang === lang ? 'bg-blue-100 text-blue-700 border-blue-200 dark:bg-blue-900/30 dark:text-blue-400 dark:border-blue-800' : 'bg-background border-border text-muted-foreground hover:bg-muted' %>">
                        <%= lang %>
                    </a>
                <% }) %>
            </div>
        </div>
        <% } %>

    </div>

    <!-- Project List -->
    <div>
        <h2 class="text-2xl font-black mb-2 text-foreground text-center mt-6">
            <%= selectedDate ? `${selectedDate.substring(0, 4)}年第${selectedDate.substring(4)}周` : '本周' %> 热门开源项目精选
        </h2>
        <p class="text-center text-muted-foreground mb-10">
            精选 <%= list.length %> 个高质量热门项目，深度解析核心能力
        </p>
        
        <div class="space-y-4 max-w-4xl mx-auto mt-8">
            <% list.forEach((item, index) => { %>
                <%- include('partials/project-article', { item, index }) %>
            <% }) %>
            
            <% if (list.length === 0) { %>
                <div class="py-12 text-center text-muted-foreground bg-card rounded-lg border border-border border-dashed">
                    没有找到相关项目
                </div>
            <% } %>
            
            <%- include('partials/pagination') %>
        </div>
    </div>
</div>
<% } %>
