<header class="border-b border-border bg-card shadow-sm sticky top-0 z-50">
    <div class="container mx-auto px-4 h-16 flex items-center justify-between">
        <div class="flex items-center gap-2 sm:gap-8">
            <a href="/" class="text-lg sm:text-xl font-bold text-primary tracking-tight shrink-0">Trending CMS</a>

            <nav class="flex items-center gap-1 sm:gap-4">
                <a href="/monthly"
                    class="px-2 sm:px-3 py-1.5 sm:py-2 rounded-md text-xs sm:text-sm font-medium transition-colors <%= type === 'monthly' ? 'bg-primary text-primary-foreground' : 'hover:bg-muted text-muted-foreground' %>">月榜</a>
                <a href="/weekly"
                    class="px-2 sm:px-3 py-1.5 sm:py-2 rounded-md text-xs sm:text-sm font-medium transition-colors <%= type === 'weekly' ? 'bg-primary text-primary-foreground' : 'hover:bg-muted text-muted-foreground' %>">周榜</a>
                <a href="/daily"
                    class="px-2 sm:px-3 py-1.5 sm:py-2 rounded-md text-xs sm:text-sm font-medium transition-colors <%= type === 'daily' ? 'bg-primary text-primary-foreground' : 'hover:bg-muted text-muted-foreground' %>">日榜</a>
            </nav>
        </div>

        <div class="flex items-center gap-2 sm:gap-4">
            <form action="" method="GET" class="relative">
                <% if (typeof selectedLang !=='undefined' && selectedLang) { %>
                    <input type="hidden" name="lang" value="<%= selectedLang %>">
                    <% } %>
                        <input type="text" name="q" placeholder="搜索 Repo..."
                            value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
                            class="w-28 sm:w-48 lg:w-64 px-2 sm:px-4 py-1.5 pl-8 sm:pl-9 rounded-full border border-border bg-background text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all">
                        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-muted-foreground absolute left-2.5 sm:left-3 top-2 sm:top-2"
                            fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
            </form>

            <button onclick="toggleTheme()"
                class="p-1.5 sm:p-2 rounded-full hover:bg-muted transition-colors focus:outline-none"
                aria-label="Toggle Theme">
                <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z">
                    </path>
                </svg>
                <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z">
                    </path>
                </svg>
            </button>

            <!-- Mobile Menu Toggle -->
            <button onclick="toggleMobileMenu()"
                class="lg:hidden p-1.5 sm:p-2 rounded-md hover:bg-muted transition-colors focus:outline-none"
                aria-label="Open Menu">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16">
                    </path>
                </svg>
            </button>
        </div>
    </div>
</header>