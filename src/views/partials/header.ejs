<header class="border-b border-border bg-card shadow-sm sticky top-0 z-10">
    <div class="container mx-auto px-4 h-16 flex items-center justify-between">
        <div class="flex items-center gap-8">
            <a href="/" class="text-xl font-bold text-primary tracking-tight">Trending CMS</a>
            
            <nav class="flex items-center gap-4">
                <a href="/monthly" class="px-3 py-2 rounded-md text-sm font-medium transition-colors <%= type === 'monthly' ? 'bg-primary text-primary-foreground' : 'hover:bg-muted text-muted-foreground' %>">月榜</a>
                <a href="/weekly" class="px-3 py-2 rounded-md text-sm font-medium transition-colors <%= type === 'weekly' ? 'bg-primary text-primary-foreground' : 'hover:bg-muted text-muted-foreground' %>">周榜</a>
                <a href="/daily" class="px-3 py-2 rounded-md text-sm font-medium transition-colors <%= type === 'daily' ? 'bg-primary text-primary-foreground' : 'hover:bg-muted text-muted-foreground' %>">日榜</a>
            </nav>
        </div>

        <div>
            <button onclick="toggleTheme()" class="p-2 rounded-full hover:bg-muted transition-colors focus:outline-none" aria-label="Toggle Theme">
                <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
            </button>
        </div>
    </div>
</header>
