<article class="bg-card border border-border rounded-xl p-5 sm:p-8 shadow-sm hover:shadow-md transition-shadow mb-12 prose dark:prose-invert max-w-none">
    <header class="mb-6">
        <h2 class="text-xl sm:text-3xl font-extrabold text-primary mb-2 mt-0 break-all sm:break-normal">
            <% if (item.summaryData && item.summaryData.title) { %>
                <%= index + 1 %>. <%= item.summaryData.title %>
            <% } else { %>
                <%= index + 1 %>. <%= item.repo %>
            <% } %>
        </h2>
        
        <div class="flex flex-wrap items-center gap-2 sm:gap-3 text-xs sm:text-sm text-muted-foreground not-prose">
            <a href="<%= item.url %>" target="_blank" class="flex items-center gap-1 hover:text-blue-500 transition-colors bg-muted px-2.5 py-1 rounded-md">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path></svg>
                <span class="font-medium"><%= item.repo %></span>
            </a>
            <% if (item.language) { %>
                <% const isLangActive = typeof type !== 'undefined' && type === 'language' && typeof filterValue !== 'undefined' && filterValue.toLowerCase() === item.language.toLowerCase(); %>
                <a href="/language/<%= encodeURIComponent(item.language) %>.html" class="px-2.5 py-1 rounded-md text-foreground font-medium transition-colors <%= isLangActive ? 'bg-primary text-primary-foreground font-bold shadow-sm' : 'bg-muted hover:bg-primary hover:text-primary-foreground' %>"><%= item.language %></a>
            <% } %>
            <span class="bg-muted px-2.5 py-1 rounded-md text-foreground flex items-center gap-1">
                ⭐ <%= item.stars %>
                <span class="text-green-500 font-bold ml-1">↑ <%= item.starsAdded %></span>
            </span>
        </div>
    </header>

    <% if (item.summaryData) { %>
        <% if (item.summaryData.cover) { %>
            <figure class="my-6 rounded-lg overflow-hidden border border-border">
                <img src="<%= item.summaryData.cover %>" alt="Cover" class="w-full h-auto object-cover max-h-96 m-0">
            </figure>
        <% } %>

        <div class="mb-6 px-4 py-3 bg-muted/30 border-l-4 border-primary rounded-r-lg italic text-lg text-foreground prose-p:my-0">
            <%- marked.parse(item.summaryData.summary || '') %>
        </div>

        <div class="mb-6 prose-p:text-lg prose-p:leading-relaxed">
            <%- marked.parse(item.summaryData.description || '') %>
        </div>

        <% if (item.summaryData.ability && item.summaryData.ability.length > 0) { %>
            <div class="mb-6">
                <h3 class="text-xl font-bold mt-0 mb-3 border-b border-border pb-2">🎯 核心能力</h3>
                <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-4 gap-y-2 mt-0 list-none pl-0">
                    <% item.summaryData.ability.forEach(ability => { %>
                        <li class="flex items-start gap-2 m-0 p-0 before:content-['✓'] before:text-green-500 before:font-bold">
                            <span><%= ability %></span>
                        </li>
                    <% }) %>
                </ul>
            </div>
        <% } %>

        <% if (item.summaryData.category && item.summaryData.category.length > 0) { %>
            <div class="flex items-start gap-2 text-sm mb-3">
                <span class="text-muted-foreground font-medium min-w-16">分类：</span>
                <div class="flex flex-wrap gap-2">
                    <% item.summaryData.category.forEach(cat => { %>
                        <% const isCatActive = typeof type !== 'undefined' && type === 'category' && typeof filterValue !== 'undefined' && filterValue.toLowerCase() === cat.toLowerCase(); %>
                        <a href="/category/<%= encodeURIComponent(cat) %>.html" class="px-2.5 py-0.5 rounded-full border transition-colors <%= isCatActive ? 'bg-primary text-primary-foreground font-bold shadow-sm border-primary' : 'bg-background text-muted-foreground border-border hover:bg-primary/10 hover:text-primary hover:border-primary' %>"><%= cat %></a>
                    <% }) %>
                </div>
            </div>
        <% } %>
        
        <% if (item.summaryData.tags && item.summaryData.tags.length > 0) { %>
            <div class="flex items-start gap-2 text-sm mb-3">
                <span class="text-muted-foreground font-medium min-w-16">标签：</span>
                <div class="flex flex-wrap gap-2">
                    <% item.summaryData.tags.forEach(tag => { %>
                        <% const isTagActive = typeof type !== 'undefined' && type === 'tag' && typeof filterValue !== 'undefined' && filterValue.toLowerCase() === tag.toLowerCase(); %>
                        <a href="/tag/<%= encodeURIComponent(tag) %>.html" class="px-2.5 py-0.5 rounded-full border transition-colors <%= isTagActive ? 'bg-primary text-primary-foreground font-bold shadow-sm border-primary' : 'bg-background text-muted-foreground border-border hover:bg-primary/10 hover:text-primary hover:border-primary' %>"><%= tag %></a>
                    <% }) %>
                </div>
            </div>
        <% } %>

        <% if (item.summaryData.suitable && item.summaryData.suitable.length > 0) { %>
            <div class="flex items-start gap-2 text-sm mb-3">
                <span class="text-muted-foreground font-medium min-w-16">适合：</span>
                <div class="flex flex-wrap gap-2">
                    <% item.summaryData.suitable.forEach(person => { %>
                        <% const isSuitActive = typeof type !== 'undefined' && type === 'suitable' && typeof filterValue !== 'undefined' && filterValue.toLowerCase() === person.toLowerCase(); %>
                        <a href="/suitable/<%= encodeURIComponent(person) %>.html" class="px-2.5 py-0.5 rounded-full border transition-colors <%= isSuitActive ? 'bg-primary text-primary-foreground font-bold shadow-sm border-primary' : 'bg-blue-50 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300 border-blue-200 dark:border-blue-800 hover:bg-blue-100 dark:hover:bg-blue-800' %>"><%= person %></a>
                    <% }) %>
                </div>
            </div>
        <% } %>

    <% } else { %>
        <!-- Fallback if no AI summary -->
        <div class="prose-p:text-lg prose-p:leading-relaxed">
            <%- item.description ? marked.parse(item.description) : '<p>暂无项目描述。</p>' %>
        </div>
    <% } %>
</article>
