<div class="space-y-6">
    <!-- About Project -->
    <div class="bg-card rounded-lg border border-border p-5 shadow-sm relative overflow-hidden">
        <div class="absolute -top-4 -right-4 p-4 opacity-5">
            <svg class="w-32 h-32 text-primary" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.416 22 12c0-5.523-4.477-10-10-10z"></path></svg>
        </div>
        <div class="relative z-10">
            <h3 class="font-bold text-sm sm:text-base text-foreground mb-2 flex items-center gap-1.5">
                👋 关于 Trending CMS
            </h3>
            <p class="text-[13px] text-muted-foreground leading-relaxed mb-4">
                这是一个 AI 驱动的 GitHub 开源项目洞察系统。我们定期收集 GitHub 热门榜单，利用 AI 深度解析项目核心特征、技术栈与受众群体，助您轻松捕获前沿技术风向。
            </p>
            <div class="flex items-center gap-3">
                <a href="https://github.com/iss-tools/github-trending" target="_blank" class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 bg-foreground text-background text-xs font-semibold rounded-md hover:bg-foreground/90 transition-colors">
                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.416 22 12c0-5.523-4.477-10-10-10z"></path></svg>
                    Star on GitHub
                </a>
                <a href="#" class="text-xs text-muted-foreground hover:text-foreground transition-colors">
                    提交反馈
                </a>
            </div>
        </div>
    </div>
    
    <%
      let activeTab = 'tags';
      if (typeof type !== 'undefined') {
          if (type === 'category') activeTab = 'categories';
          else if (type === 'topic') activeTab = 'topics';
          else if (type === 'language') activeTab = 'languages';
      }
    %>
    <!-- Metadata Tabs -->
    <div class="bg-card rounded-lg border border-border shadow-sm flex flex-col">
        <!-- Tab Headers -->
        <div class="flex border-b border-border text-xs sm:text-sm font-medium px-2 pt-2 gap-1 overflow-x-auto custom-scrollbar">
            <button onclick="switchMetaTab('tags')" id="tab-tags" class="meta-tab px-3 sm:px-4 py-1.5 sm:py-2 border-b-2 transition-colors whitespace-nowrap <%= activeTab === 'tags' ? 'border-primary text-foreground' : 'border-transparent text-muted-foreground hover:text-foreground' %>">标签</button>
            <button onclick="switchMetaTab('categories')" id="tab-categories" class="meta-tab px-3 sm:px-4 py-1.5 sm:py-2 border-b-2 transition-colors whitespace-nowrap <%= activeTab === 'categories' ? 'border-primary text-foreground' : 'border-transparent text-muted-foreground hover:text-foreground' %>">分类</button>
            <button onclick="switchMetaTab('topics')" id="tab-topics" class="meta-tab px-3 sm:px-4 py-1.5 sm:py-2 border-b-2 transition-colors whitespace-nowrap <%= activeTab === 'topics' ? 'border-primary text-foreground' : 'border-transparent text-muted-foreground hover:text-foreground' %>">Topics</button>
            <button onclick="switchMetaTab('languages')" id="tab-languages" class="meta-tab px-3 sm:px-4 py-1.5 sm:py-2 border-b-2 transition-colors whitespace-nowrap <%= activeTab === 'languages' ? 'border-primary text-foreground' : 'border-transparent text-muted-foreground hover:text-foreground' %>">开发语言</button>
        </div>
        
        <!-- Tab Contents -->
        <div class="p-4 max-h-72 overflow-y-auto custom-scrollbar">
            <!-- Tags -->
            <div id="content-tags" class="meta-content flex-wrap gap-2 <%= activeTab === 'tags' ? 'flex' : 'hidden' %>">
                <% if (meta.topTags) { meta.topTags.forEach(tagObj => { %>
                    <% const isActive = typeof type !== 'undefined' && type === 'tag' && typeof filterValue !== 'undefined' && filterValue.toLowerCase() === tagObj.tag.toLowerCase(); %>
                    <a href="/tag/<%= encodeURIComponent(tagObj.tag) %>.html" class="px-2 sm:px-3 py-0.5 sm:py-1 rounded-full text-[11px] sm:text-xs transition-colors <%= isActive ? 'bg-primary text-primary-foreground font-bold shadow-sm' : 'bg-muted text-muted-foreground hover:bg-primary/80 hover:text-primary-foreground' %>">
                        <%= tagObj.tag %> <span class="opacity-50 text-[10px] ml-1"><%= tagObj.count %></span>
                    </a>
                <% })} %>
                <% if (!meta.topTags || meta.topTags.length === 0) { %>
                    <span class="text-sm text-muted-foreground">暂无标签数据</span>
                <% } %>
            </div>
            
            <!-- Categories -->
            <div id="content-categories" class="meta-content flex-wrap gap-2 <%= activeTab === 'categories' ? 'flex' : 'hidden' %>">
                <% if (meta.topCategories) { meta.topCategories.forEach(catObj => { %>
                    <% const isActive = typeof type !== 'undefined' && type === 'category' && typeof filterValue !== 'undefined' && filterValue.toLowerCase() === catObj.name.toLowerCase(); %>
                    <a href="/category/<%= encodeURIComponent(catObj.name) %>.html" class="px-2 sm:px-3 py-0.5 sm:py-1 rounded-full text-[11px] sm:text-xs transition-colors <%= isActive ? 'bg-primary text-primary-foreground font-bold shadow-sm' : 'bg-muted text-muted-foreground hover:bg-primary/80 hover:text-primary-foreground' %>">
                        <%= catObj.name %> <span class="opacity-50 text-[10px] ml-1"><%= catObj.count %></span>
                    </a>
                <% })} %>
                <% if (!meta.topCategories || meta.topCategories.length === 0) { %>
                    <span class="text-sm text-muted-foreground">暂无分类数据</span>
                <% } %>
            </div>
            
            <!-- Topics -->
            <div id="content-topics" class="meta-content flex-wrap gap-2 <%= activeTab === 'topics' ? 'flex' : 'hidden' %>">
                <% if (meta.topTopics) { meta.topTopics.forEach(topicObj => { %>
                    <% const isActive = typeof type !== 'undefined' && type === 'topic' && typeof filterValue !== 'undefined' && filterValue.toLowerCase() === topicObj.name.toLowerCase(); %>
                    <a href="/topic/<%= encodeURIComponent(topicObj.name) %>.html" class="px-2 sm:px-3 py-0.5 sm:py-1 rounded-full text-[11px] sm:text-xs transition-colors <%= isActive ? 'bg-primary text-primary-foreground font-bold shadow-sm' : 'bg-muted text-muted-foreground hover:bg-primary/80 hover:text-primary-foreground' %>">
                        <%= topicObj.name %> <span class="opacity-50 text-[10px] ml-1"><%= topicObj.count %></span>
                    </a>
                <% })} %>
                <% if (!meta.topTopics || meta.topTopics.length === 0) { %>
                    <span class="text-sm text-muted-foreground">暂无Topic数据</span>
                <% } %>
            </div>
            
            <!-- Languages -->
            <div id="content-languages" class="meta-content flex-wrap gap-2 <%= activeTab === 'languages' ? 'flex' : 'hidden' %>">
                <% if (meta.topLanguages) { meta.topLanguages.forEach(langObj => { %>
                    <% const isActive = typeof type !== 'undefined' && type === 'language' && typeof filterValue !== 'undefined' && filterValue.toLowerCase() === langObj.name.toLowerCase(); %>
                    <a href="/language/<%= encodeURIComponent(langObj.name) %>.html" class="px-2 sm:px-3 py-0.5 sm:py-1 rounded-full text-[11px] sm:text-xs transition-colors <%= isActive ? 'bg-primary text-primary-foreground font-bold shadow-sm' : 'bg-muted text-muted-foreground hover:bg-primary/80 hover:text-primary-foreground' %>">
                        <%= langObj.name %> <span class="opacity-50 text-[10px] ml-1"><%= langObj.count %></span>
                    </a>
                <% })} %>
                <% if (!meta.topLanguages || meta.topLanguages.length === 0) { %>
                    <span class="text-sm text-muted-foreground">暂无开发语言数据</span>
                <% } %>
            </div>
        </div>
    </div>
    
    <script>
    function switchMetaTab(tabName) {
        document.querySelectorAll('.meta-tab').forEach(el => {
            el.classList.remove('border-primary', 'text-foreground');
            el.classList.add('border-transparent', 'text-muted-foreground');
        });
        document.querySelectorAll('.meta-content').forEach(el => {
            el.classList.add('hidden');
            el.classList.remove('flex');
        });
        
        const activeTab = document.getElementById('tab-' + tabName);
        if(activeTab) {
            activeTab.classList.remove('border-transparent', 'text-muted-foreground');
            activeTab.classList.add('border-primary', 'text-foreground');
        }
        
        const activeContent = document.getElementById('content-' + tabName);
        if(activeContent) {
            activeContent.classList.remove('hidden');
            activeContent.classList.add('flex');
        }
    }
    </script>

    <!-- Rankings -->
    <div class="bg-card rounded-lg border border-border p-6 shadow-sm">
        
        <div class="flex items-center justify-between mb-4 border-b border-border pb-2">
            <h3 class="font-bold text-lg text-primary">排行榜</h3>
            <div class="flex text-xs bg-muted rounded-md p-1">
                <button id="btn-stars" onclick="switchRankingTab('stars')" class="px-2 py-1 rounded-sm bg-background shadow-sm text-foreground">Star 榜</button>
                <button id="btn-appearances" onclick="switchRankingTab('appearances')" class="px-2 py-1 rounded-sm text-muted-foreground hover:text-foreground transition-colors">上榜次数</button>
            </div>
        </div>

        <!-- Star Ranking -->
        <div id="ranking-stars" class="space-y-3">
            <% meta.topStars.forEach((repo, index) => { %>
                <a href="<%= repo.url %>" target="_blank" class="flex items-center justify-between group">
                    <div class="flex items-center gap-3 overflow-hidden">
                        <span class="text-sm font-bold <%= index < 3 ? 'text-blue-500' : 'text-muted-foreground' %>"><%= index + 1 %></span>
                        <span class="text-sm text-foreground truncate group-hover:text-blue-500 transition-colors"><%= repo.repo %></span>
                    </div>
                    <span class="text-xs text-muted-foreground bg-muted px-2 py-1 rounded-md flex-shrink-0 flex items-center gap-1">
                        ⭐ <%= (repo.stars / 1000).toFixed(1) %>k
                    </span>
                </a>
            <% }) %>
            <% if (meta.topStars.length === 0) { %>
                <span class="text-sm text-muted-foreground">暂无榜单数据</span>
            <% } %>
        </div>

        <!-- Appearances Ranking -->
        <div id="ranking-appearances" class="space-y-3 hidden">
            <% meta.topAppearances.forEach((repo, index) => { %>
                <a href="<%= repo.url %>" target="_blank" class="flex items-center justify-between group">
                    <div class="flex items-center gap-3 overflow-hidden">
                        <span class="text-sm font-bold <%= index < 3 ? 'text-blue-500' : 'text-muted-foreground' %>"><%= index + 1 %></span>
                        <span class="text-sm text-foreground truncate group-hover:text-blue-500 transition-colors"><%= repo.repo %></span>
                    </div>
                    <span class="text-xs text-muted-foreground bg-muted px-2 py-1 rounded-md flex-shrink-0 flex items-center gap-1">
                        🔥 <%= repo.appearances %>次
                    </span>
                </a>
            <% }) %>
            <% if (meta.topAppearances.length === 0) { %>
                <span class="text-sm text-muted-foreground">暂无榜单数据</span>
            <% } %>
        </div>
    </div>
</div>

<script>
    function switchRankingTab(tabName) {
        // Toggle buttons
        const btnStars = document.getElementById('btn-stars');
        const btnAppearances = document.getElementById('btn-appearances');
        
        if (tabName === 'stars') {
            btnStars.classList.add('bg-background', 'shadow-sm', 'text-foreground');
            btnStars.classList.remove('text-muted-foreground', 'hover:text-foreground');
            btnAppearances.classList.add('text-muted-foreground', 'hover:text-foreground');
            btnAppearances.classList.remove('bg-background', 'shadow-sm', 'text-foreground');
            
            document.getElementById('ranking-stars').classList.remove('hidden');
            document.getElementById('ranking-appearances').classList.add('hidden');
        } else {
            btnAppearances.classList.add('bg-background', 'shadow-sm', 'text-foreground');
            btnAppearances.classList.remove('text-muted-foreground', 'hover:text-foreground');
            btnStars.classList.add('text-muted-foreground', 'hover:text-foreground');
            btnStars.classList.remove('bg-background', 'shadow-sm', 'text-foreground');
            
            document.getElementById('ranking-appearances').classList.remove('hidden');
            document.getElementById('ranking-stars').classList.add('hidden');
        }
    }
</script>
