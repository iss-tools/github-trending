<% if (typeof isListView !== 'undefined' && isListView) { %>
    <div class="space-y-6">
        <h2 class="text-xl font-bold mb-4 text-foreground">日榜历史</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <% dateCards.forEach(card => { %>
                <a href="/<%= type %>/<%= card.dateStr %>.html" class="block p-6 bg-card rounded-lg border border-border hover:border-primary hover:shadow-md transition-all group flex flex-col h-full">
                    <div class="mb-4 flex-grow">
                        <h3 class="text-lg font-semibold text-foreground group-hover:text-primary mb-2 transition-colors">
                            <%= card.dateStr.substring(0, 4) %>-<%= card.dateStr.substring(4, 6) %>-<%= card.dateStr.substring(6, 8) %>
                        </h3>
                        <p class="text-sm text-muted-foreground">共 <%= card.total %> 个热门项目</p>
                    </div>
                    
                    <% if (card.langStats && card.langStats.length > 0) { %>
                        <div class="flex flex-wrap gap-1.5 mt-auto border-t border-border pt-4">
                            <% card.langStats.forEach(stat => { %>
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-muted text-muted-foreground">
                                    <%= stat.lang %>: <%= stat.count %>
                                </span>
                            <% }) %>
                        </div>
                    <% } %>
                </a>
            <% }) %>
            <% if (dateCards.length === 0) { %>
                <div class="col-span-full py-12 text-center text-muted-foreground bg-card rounded-lg border border-border border-dashed">
                    暂无历史数据
                </div>
            <% } %>
        </div>
        <%- include('partials/pagination') %>
    </div>
<% } else { %>
<div class="space-y-6">
    <!-- Filters Area -->
    <div class="bg-card rounded-lg border border-border p-4 flex flex-col gap-4 shadow-sm sticky top-16">
        
        <!-- Date Selector -->
        <div class="flex items-center gap-4 flex-wrap">
            <div class="flex items-center gap-2">
                <span class="text-sm font-semibold text-foreground">选择日期:</span>
                <select class="bg-background border border-border rounded-md px-3 py-1.5 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" 
                        onchange="window.location.href=this.value">
                    <% dates.forEach(dateStr => { %>
                        <option value="/<%= type %>/<%= dateStr %>.html" <%= selectedDate === dateStr ? 'selected' : '' %>>
                            <%= dateStr.substring(0, 4) %>-<%= dateStr.substring(4, 6) %>-<%= dateStr.substring(6, 8) %>
                        </option>
                    <% }) %>
                </select>
            </div>
            
            <div class="hidden sm:flex items-center text-muted-foreground text-sm px-2">|</div>
            
            <div class="flex gap-2 overflow-x-auto pb-1 custom-scrollbar items-center">
                <span class="text-xs text-muted-foreground whitespace-nowrap">最近:</span>
                <% dates.slice(0, 7).forEach(dateStr => { %>
                    <a href="/<%= type %>/<%= dateStr %>.html" 
                       class="px-2.5 py-1 rounded-md text-xs border whitespace-nowrap transition-colors <%= selectedDate === dateStr ? 'bg-primary text-primary-foreground border-primary font-medium' : 'bg-background border-border text-muted-foreground hover:bg-muted' %>">
                        <%= dateStr.substring(4, 6) %>-<%= dateStr.substring(6, 8) %>
                    </a>
                <% }) %>
                <% if (dates.length === 0) { %>
                    <span class="text-sm text-muted-foreground">暂无数据</span>
                <% } %>
            </div>
        </div>

        <!-- Language Selector (Anchor Links) -->
        <% 
            const groupedList = {};
            list.forEach(item => {
                const lang = item.language || 'Unknown';
                if (!groupedList[lang]) groupedList[lang] = [];
                groupedList[lang].push(item);
            });
            const sortedLangs = Object.keys(groupedList).sort((a,b) => {
                if(a === 'Unknown') return 1;
                if(b === 'Unknown') return -1;
                return groupedList[b].length - groupedList[a].length; // Sort by count descending
            });
        %>
        <% if (sortedLangs.length > 0) { %>
        <div class="sticky top-16 z-20 bg-background pt-2 pb-2 sm:static sm:pt-0 sm:pb-0 sm:bg-transparent mt-6">
            <div class="flex overflow-x-auto border-b border-border w-full" style="scrollbar-width: none;">
                <% sortedLangs.forEach(lang => { %>
                    <a href="#lang-<%= encodeURIComponent(lang) %>" class="px-4 py-2 text-sm font-semibold whitespace-nowrap border-b-2 border-transparent transition-colors text-muted-foreground hover:text-foreground hover:border-border shrink-0">
                        <%= lang %>
                    </a>
                <% }) %>
            </div>
        </div>
        <% } %>

    </div>

    <!-- Project List -->
    <div>
        <h2 class="text-2xl font-black mb-2 text-foreground text-center mt-6">
            <%= selectedDate ? `${selectedDate.substring(0, 4)}-${selectedDate.substring(4, 6)}-${selectedDate.substring(6, 8)}` : '今日' %> 热门开源项目精选
        </h2>
        <p class="text-center text-muted-foreground mb-10">
            精选 <%= list.length %> 个高质量热门项目，深度解析核心能力
        </p>
        
        <div class="space-y-12 max-w-4xl mx-auto mt-8">
            <% sortedLangs.forEach(lang => { %>
                <div class="scroll-mt-24" id="lang-<%= encodeURIComponent(lang) %>">
                    <div class="flex items-center gap-4 mb-6">
                        <h3 class="text-xl font-bold text-foreground m-0"><%= lang %></h3>
                        <div class="h-px bg-border flex-grow"></div>
                        <span class="text-xs text-muted-foreground bg-muted px-2 py-1 rounded-full"><%= groupedList[lang].length %> 个项目</span>
                    </div>
                    
                    <div class="space-y-4">
                        <% groupedList[lang].forEach((item, idx) => { %>
                            <%- include('partials/project-article', { item, index: idx }) %>
                        <% }) %>
                    </div>
                </div>
            <% }) %>
            
            <% if (list.length === 0) { %>
                <div class="py-12 text-center text-muted-foreground bg-card rounded-lg border border-border border-dashed">
                    没有找到相关项目
                </div>
            <% } %>
        </div>
    </div>
</div>
<% } %>
