<!DOCTYPE html>
<html lang="en" class="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof seoTitle !== 'undefined' ? seoTitle : 'GitHub 热门项目追踪 | Trending' %></title>
    <meta name="description" content="<%= typeof seoDescription !== 'undefined' ? seoDescription : 'AI 驱动的 GitHub 开源项目洞察系统，定期解析热门榜单与技术趋势' %>">
    <meta name="keywords" content="<%= typeof seoKeywords !== 'undefined' ? seoKeywords : 'GitHub Trending,开源项目,技术趋势,AI解析' %>">
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    
    <link href="/style.css" rel="stylesheet">
    <script>
        // Check local storage for theme or use system preference
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }

        function toggleTheme() {
            if (document.documentElement.classList.contains('dark')) {
                document.documentElement.classList.remove('dark');
                localStorage.setItem('theme', 'light');
            } else {
                document.documentElement.classList.add('dark');
                localStorage.setItem('theme', 'dark');
            }
        }
    </script>
    
    <!-- KaTeX CSS for Server-rendered Math -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css">

    <!-- Highlight.js for Code Syntax Highlighting -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/highlight.js@11.8.0/styles/github.min.css" id="highlight-theme-light">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/highlight.js@11.8.0/styles/github-dark.min.css" id="highlight-theme-dark" disabled>
    <script src="https://cdn.jsdelivr.net/npm/highlight.js@11.8.0/lib/highlight.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            hljs.highlightAll();
            
            // Sync highlight theme with the site theme
            const isDark = document.documentElement.classList.contains('dark');
            if (isDark) {
                document.getElementById('highlight-theme-light').disabled = true;
                document.getElementById('highlight-theme-dark').disabled = false;
            }
        });
        
        // Update toggleTheme function to also toggle highlight.js theme
        const originalToggle = toggleTheme;
        toggleTheme = function() {
            originalToggle();
            const isDark = document.documentElement.classList.contains('dark');
            document.getElementById('highlight-theme-light').disabled = isDark;
            document.getElementById('highlight-theme-dark').disabled = !isDark;
        };
    </script>

    <!-- Mermaid for Diagrams -->
    <script type="module">
        import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
        
        const isDark = document.documentElement.classList.contains('dark');
        mermaid.initialize({ startOnLoad: false, theme: isDark ? 'dark' : 'default' });
        
        document.addEventListener("DOMContentLoaded", () => {
            const mermaidBlocks = document.querySelectorAll('code.language-mermaid');
            mermaidBlocks.forEach(block => {
                const pre = block.parentElement;
                if (pre && pre.tagName === 'PRE') {
                    pre.classList.add('mermaid');
                    pre.classList.add('flex', 'justify-center', 'cursor-pointer', 'hover:opacity-90', 'transition-opacity');
                    pre.title = "点击查看完整结构图";
                    pre.textContent = block.textContent; // Replace code tag with raw text
                }
            });
            mermaid.run().then(() => {
                document.querySelectorAll('.mermaid svg').forEach(svg => {
                    svg.addEventListener('click', function(e) {
                        e.stopPropagation();
                        openZoomModal(this);
                    });
                });
            });

            // Support zooming for standard Markdown images
            document.querySelectorAll('.prose img').forEach(img => {
                img.classList.add('cursor-pointer', 'hover:opacity-90', 'transition-opacity');
                img.title = "点击查看大图";
                img.addEventListener('click', function(e) {
                    e.stopPropagation();
                    openZoomModal(this);
                });
            });
        });
    </script>
    <!-- Vercel Analytics -->
    <script>
        window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
    </script>
    <script defer src="/_vercel/insights/script.js"></script>
</head>

<body class="min-h-screen flex flex-col bg-background text-foreground font-sans antialiased">

    <%- include('../partials/header') %>

        <main class="flex-grow container mx-auto px-4 py-8 flex flex-col lg:flex-row gap-8 relative">
            <!-- Main Content Area -->
            <div class="flex-grow w-full lg:w-3/4">
                <%- include(body) %>
            </div>

            <!-- Mobile Sidebar Overlay -->
            <div id="mobile-menu-overlay"
                class="fixed inset-0 bg-black/50 z-[60] hidden lg:hidden opacity-0 transition-opacity duration-300"
                onclick="toggleMobileMenu()"></div>

            <!-- Sidebar -->
            <div id="sidebar-container"
                class="fixed inset-y-0 right-0 z-[70] w-11/12 sm:w-96 bg-background shadow-2xl transform translate-x-full transition-transform duration-300 lg:static lg:translate-x-0 lg:w-1/4 lg:shadow-none lg:bg-transparent overflow-y-auto lg:overflow-visible p-5 lg:p-0 flex-shrink-0">
                <!-- Mobile Close Button -->
                <div class="flex justify-between items-center mb-6 lg:hidden">
                    <h2 class="font-bold text-lg text-primary">菜单</h2>
                    <button onclick="toggleMobileMenu()"
                        class="p-2 bg-muted rounded-full hover:bg-muted/80 text-muted-foreground focus:outline-none">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>

                <%- include('../partials/sidebar') %>
            </div>
        </main>

        <%- include('../partials/footer') %>

            <!-- Mermaid Zoom Modal -->
            <div id="mermaid-modal" class="fixed inset-0 z-[100] hidden bg-black/80 flex items-center justify-center p-4">
                <div class="absolute inset-0 cursor-pointer" onclick="closeMermaidModal()"></div>
                <button onclick="closeMermaidModal()" class="absolute top-4 right-4 p-2 bg-black/50 text-white hover:bg-black rounded-full z-[101] transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
                <div class="relative w-full h-full flex items-center justify-center overflow-hidden pointer-events-none" id="mermaid-modal-container">
                    <!-- cloned svg goes here -->
                </div>
                <div class="absolute bottom-6 left-1/2 transform -translate-x-1/2 text-white/80 text-sm flex gap-6 pointer-events-none z-[101] bg-black/50 px-4 py-2 rounded-full backdrop-blur-sm">
                    <span class="flex items-center gap-2"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path></svg> 滚轮缩放</span>
                    <span class="flex items-center gap-2"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v2a7.5 7.5 0 0015 0v-5a1.5 1.5 0 00-3 0m-6-3V11m0-5.5v-1a1.5 1.5 0 013 0v1m0 0V11"></path></svg> 拖拽移动</span>
                </div>
            </div>

            <script>
                function toggleMobileMenu() {
                    const sidebar = document.getElementById('sidebar-container');
                    const overlay = document.getElementById('mobile-menu-overlay');

                    if (sidebar.classList.contains('translate-x-full')) {
                        // Open menu
                        sidebar.classList.remove('translate-x-full');
                        overlay.classList.remove('hidden');
                        // slight delay for opacity transition
                        setTimeout(() => overlay.classList.remove('opacity-0'), 10);
                        document.body.style.overflow = 'hidden'; // Prevent background scrolling
                    } else {
                        // Close menu
                        sidebar.classList.add('translate-x-full');
                        overlay.classList.add('opacity-0');
                        setTimeout(() => overlay.classList.add('hidden'), 300);
                        document.body.style.overflow = '';
                    }
                }

                // Zooming and Dragging Logic
                let mScale = 1;
                let mIsDragging = false;
                let mStartX, mStartY, mTranslateX = 0, mTranslateY = 0;
                
                function openZoomModal(element) {
                    const modal = document.getElementById('mermaid-modal');
                    const container = document.getElementById('mermaid-modal-container');
                    container.innerHTML = '';
                    
                    const clone = element.cloneNode(true);
                    mScale = 1;
                    mTranslateX = 0;
                    mTranslateY = 0;
                    
                    clone.style.transform = `translate(${mTranslateX}px, ${mTranslateY}px) scale(${mScale})`;
                    clone.style.transformOrigin = 'center center';
                    clone.style.cursor = 'grab';
                    clone.style.transition = 'transform 0.1s ease-out';
                    clone.style.pointerEvents = 'auto'; 
                    clone.classList.remove('max-w-full', 'w-full', 'hover:opacity-90'); 
                    clone.style.width = 'auto';
                    clone.style.height = 'auto';
                    clone.style.maxHeight = '90vh';
                    clone.style.maxWidth = '90vw';
                    clone.style.objectFit = 'contain';
                    
                    // Only apply background/padding if it's an SVG (mermaid), regular images should be transparent
                    if (clone.tagName === 'svg') {
                        clone.style.backgroundColor = document.documentElement.classList.contains('dark') ? '#020817' : '#ffffff';
                        clone.classList.add('p-6', 'rounded-xl', 'shadow-2xl');
                    } else {
                        clone.classList.add('rounded-lg', 'shadow-2xl');
                    }
                    
                    container.appendChild(clone);
                    modal.classList.remove('hidden');
                    document.body.style.overflow = 'hidden';
                    
                    // Dragging
                    clone.addEventListener('mousedown', e => {
                        mIsDragging = true;
                        clone.style.cursor = 'grabbing';
                        clone.style.transition = 'none'; 
                        mStartX = e.clientX - mTranslateX;
                        mStartY = e.clientY - mTranslateY;
                    });
                    
                    window.addEventListener('mousemove', e => {
                        if (!mIsDragging) return;
                        mTranslateX = e.clientX - mStartX;
                        mTranslateY = e.clientY - mStartY;
                        updateMermaidTransform(clone);
                    });
                    
                    window.addEventListener('mouseup', () => {
                        if (mIsDragging) {
                            mIsDragging = false;
                            clone.style.cursor = 'grab';
                            clone.style.transition = 'transform 0.1s ease-out';
                        }
                    });
                    
                    // Zooming
                    clone.addEventListener('wheel', e => {
                        e.preventDefault();
                        const delta = e.deltaY > 0 ? -0.1 : 0.1;
                        mScale = Math.max(0.2, Math.min(mScale + delta, 5)); 
                        updateMermaidTransform(clone);
                    }, { passive: false });
                }
                
                function updateMermaidTransform(el) {
                    el.style.transform = `translate(${mTranslateX}px, ${mTranslateY}px) scale(${mScale})`;
                }
                
                function closeMermaidModal() {
                    document.getElementById('mermaid-modal').classList.add('hidden');
                    document.body.style.overflow = '';
                }
            </script>
</body>

</html>