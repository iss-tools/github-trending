{
  "name": "trending",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "npm-run-all --parallel watch:css watch:server",
    "watch:css": "tailwindcss -i ./src/public/style.css -o ./public/style.css --watch",
    "watch:server": "tsx watch src/server.ts",
    "build:css": "tailwindcss -i ./src/public/style.css -o ./public/style.css --minify",
    "export": "tsx src/scripts/exportData.ts",
    "build:static": "npm run build:css && tsx src/scripts/generateStatic.ts",
    "push": "cd .. && git subtree push --prefix trending public-trending main"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/marked": "^6.0.0",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.5.4",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.26",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "katex": "^0.18.4",
    "marked": "^18.0.10",
    "marked-katex-extension": "^5.1.12"
  }
}
